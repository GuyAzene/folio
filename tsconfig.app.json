{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "lib": ["ES2024", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "types": ["vite/client"],
    "allowJs": true,
    "checkJs": true,
    "isolatedModules": true
  },
  "include": [
    "app/**/*.ts",
    "app/**/*.svelte",
    "src/chat-title.ts",
    "src/desktop/api.ts",
    "src/visual.ts",
    "tests/fixtures/synthetic-pdf.ts",
    "tests/fixtures/diagrams.ts"
  ],
  "exclude": ["node_modules", "build", "dist", "dist-desktop"]
}
